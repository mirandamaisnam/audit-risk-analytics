# --- Data (raw research/proprietary data should not be committed) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Power BI (binary, large; track via screenshots/exports instead) ---
*.pbix

# --- OS / temp ---
*.log
*.tmp
.DS_Store
